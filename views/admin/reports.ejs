<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Báo cáo doanh thu | Admin Thanh Sơn</title>
  <link rel="stylesheet" href="/css/admin.css?v=20261124">
</head>
<body class="admin-shell">
  <%- include('_layout', { active: 'reports' }) %>
  <main class="admin-main">
    <header class="admin-top">
      <div>
        <p class="eyebrow">BÁO CÁO TÀI CHÍNH</p>
        <h1>Báo cáo doanh thu & kinh doanh</h1>
        <p class="muted">Số liệu thực tế từ các đơn hàng đã thanh toán và hoàn tất.</p>
      </div>
      <div class="report-formula-note">
        <small class="muted"><strong>Công thức tính:</strong> Doanh thu thực = Tổng giá trị đơn hàng có <code>paymentStatus = 'paid'</code> (không tính đơn hủy/chờ thanh toán).</small>
      </div>
    </header>

    <section class="stat-grid" id="summaryStats">
      <article class="stat-card">
        <span>Doanh thu thực tế (Đã thu)</span>
        <strong id="statPaidRevenue">0 ₫</strong>
      </article>
      <article class="stat-card">
        <span>Hôm nay</span>
        <strong id="statRevenueToday">0 ₫</strong>
      </article>
      <article class="stat-card">
        <span>Tháng này</span>
        <strong id="statRevenueMonth">0 ₫</strong>
      </article>
      <article class="stat-card">
        <span>Giá trị đơn trung bình (AOV)</span>
        <strong id="statAov">0 ₫</strong>
      </article>
    </section>

    <div class="admin-grid-2">
      <section class="admin-panel">
        <h2>Phân tích theo phương thức thanh toán</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Phương thức</th>
                <th>Số lượng đơn</th>
                <th>Doanh thu đã thu</th>
                <th>Tỷ lệ</th>
              </tr>
            </thead>
            <tbody id="paymentMethodRows">
              <tr><td colspan="4">Đang tính toán...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="admin-panel">
        <h2>Tình trạng đơn hàng & Hủy đơn</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Trạng thái</th>
                <th>Số đơn</th>
                <th>Giá trị</th>
              </tr>
            </thead>
            <tbody id="orderStatusRows">
              <tr><td colspan="3">Đang tính toán...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <section class="admin-panel">
      <h2>Sản phẩm bán chạy nhất (Top Sellers)</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Sản phẩm</th>
              <th>SKU</th>
              <th>Số lượng bán</th>
              <th>Tổng doanh thu</th>
            </tr>
          </thead>
          <tbody id="bestSellersRows">
            <tr><td colspan="4">Đang tính toán...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script src="/js/admin.js"></script>
  <script>
    (async () => {
      try {
        const res = await fetch('/api/admin/reports');
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'Không thể tải báo cáo.');

        document.getElementById('statPaidRevenue').textContent = Number(data.totalPaidRevenue || 0).toLocaleString('vi-VN') + ' ₫';
        document.getElementById('statRevenueToday').textContent = Number(data.revenueToday || 0).toLocaleString('vi-VN') + ' ₫';
        document.getElementById('statRevenueMonth').textContent = Number(data.revenueThisMonth || 0).toLocaleString('vi-VN') + ' ₫';
        document.getElementById('statAov').textContent = Number(data.aov || 0).toLocaleString('vi-VN') + ' ₫';

        // Payment methods
        const pmBody = document.getElementById('paymentMethodRows');
        pmBody.replaceChildren();
        const totalRev = Number(data.totalPaidRevenue || 1);
        (data.paymentMethods || []).forEach(pm => {
          const tr = document.createElement('tr');
          const pct = Math.round((Number(pm.revenue || 0) / (totalRev || 1)) * 100);
          tr.innerHTML = `
            <td><strong>${pm.method === 'bank_transfer' ? 'Chuyển khoản VietQR' : 'Thanh toán COD'}</strong></td>
            <td>${pm.count} đơn</td>
            <td>${Number(pm.revenue || 0).toLocaleString('vi-VN')} ₫</td>
            <td><span class="badge ${pct > 0 ? 'success' : 'muted'}">${pct}%</span></td>
          `;
          pmBody.appendChild(tr);
        });

        // Order statuses
        const statusBody = document.getElementById('orderStatusRows');
        statusBody.replaceChildren();
        const statusLabels = {
          pending: 'Chờ xử lý',
          confirmed: 'Đã xác nhận',
          processing: 'Đang chuẩn bị',
          shipped: 'Đang giao hàng',
          delivered: 'Đã giao hàng',
          cancelled: 'Đã hủy',
          failed: 'Thất bại'
        };
        (data.orderStatuses || []).forEach(st => {
          const tr = document.createElement('tr');
          const isCancel = st.status === 'cancelled' || st.status === 'failed';
          tr.innerHTML = `
            <td><span class="badge ${isCancel ? 'error' : 'info'}">${statusLabels[st.status] || st.status}</span></td>
            <td>${st.count} đơn</td>
            <td>${Number(st.value || 0).toLocaleString('vi-VN')} ₫</td>
          `;
          statusBody.appendChild(tr);
        });

        // Best sellers
        const bsBody = document.getElementById('bestSellersRows');
        bsBody.replaceChildren();
        if (!data.bestSellers || !data.bestSellers.length) {
          bsBody.innerHTML = '<tr><td colspan="4">Chưa có dữ liệu sản phẩm bán ra.</td></tr>';
        } else {
          data.bestSellers.forEach(bs => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><strong>${bs.name}</strong></td>
              <td>${bs.sku || '—'}</td>
              <td><strong>${bs.quantity}</strong> chiếc</td>
              <td>${Number(bs.revenue || 0).toLocaleString('vi-VN')} ₫</td>
            `;
            bsBody.appendChild(tr);
          });
        }
      } catch (err) {
        console.error(err);
      }
    })();
  </script>
</body>
</html>
