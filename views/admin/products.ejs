<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý sản phẩm | Admin Thanh Sơn</title>
  <link rel="stylesheet" href="/css/admin.css?v=20261125">
</head>
<body class="admin-shell">
  <%- include('_layout', { active: 'products' }) %>
  <main class="admin-main">
    <header class="admin-top">
      <div>
        <p class="eyebrow">CATALOG & INVENTORY</p>
        <h1>Quản lý sản phẩm</h1>
        <p class="muted">Toàn bộ áo dài cách tân: Thêm mới, chỉnh sửa, cập nhật tồn kho tức thì và quản lý trạng thái.</p>
      </div>
      <button class="admin-button primary" id="newProduct" type="button">+ Thêm sản phẩm mới</button>
    </header>

    <p id="productNotice" class="notice" role="status" hidden></p>

    <!-- Form Thêm / Chỉnh sửa sản phẩm -->
    <section class="admin-panel" id="productFormPanel">
      <form id="productForm" class="admin-form">
        <input type="hidden" name="id">
        <div class="form-title">
          <div>
            <p class="eyebrow" id="formEyebrow">PRODUCT DETAILS</p>
            <h2 id="productFormTitle">Thêm sản phẩm mới</h2>
          </div>
        </div>
        <div class="form-grid">
          <label>Tên sản phẩm *
            <input name="name" required maxlength="200" placeholder="Ví dụ: Áo dài cách tân lụa thêu hoa">
          </label>
          <label>Mã SKU *
            <input name="sku" required maxlength="80" placeholder="Ví dụ: TSF-AD-014">
          </label>
          <label>Mã sản phẩm (Nội bộ)
            <input name="productCode" maxlength="80" placeholder="Ví dụ: AD-014">
          </label>
          <label>Slug URL (Để trống để tự tạo)
            <input name="slug" placeholder="ao-dai-cach-tan-lua-theu-hoa">
          </label>
          <label>Giá bán (VND) *
            <input name="price" type="number" min="0" step="1" required placeholder="Ví dụ: 450000">
          </label>
          <label>Giá gốc niêm yết (VND)
            <input name="originalPrice" type="number" min="0" step="1" placeholder="Ví dụ: 550000">
          </label>
          <label>Giá khuyến mãi (VND)
            <input name="salePrice" type="number" min="0" step="1" placeholder="Ví dụ: 420000">
          </label>
          <label>Tồn kho tổng (Tự tính khi có biến thể)
            <input name="stock" type="number" min="0" step="1" value="0">
          </label>
          <label>Chất liệu vải
            <input name="material" placeholder="Lụa Tơ Tằm, Gấm Thượng Hải, Nhung Then, Organza...">
          </label>
          <label>Kiểu dáng thiết kế
            <input name="designStyle" placeholder="Dáng suông trẻ trung, Tà kép sang trọng, Tay bồng quý phái...">
          </label>
          <label>Thương hiệu
            <input name="brand" value="Thanh Sơn" placeholder="Thanh Sơn Fashion">
          </label>
          <label>Từ khóa Tags
            <input name="tags" placeholder="áo dài, cách tân, lễ tết, sự kiện, dạo phố">
          </label>
          <label class="wide">Ảnh chính sản phẩm (URL)
            <input name="image" type="url" placeholder="https://... hoặc /images/products/...">
          </label>
          <div class="wide" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <label style="flex: 1; min-width: 220px; margin: 0;">Hoặc tải ảnh từ máy tính
              <input id="productImageFile" type="file" accept="image/jpeg,image/png,image/webp">
            </label>
            <button class="admin-button" id="uploadProductImage" type="button" style="align-self: flex-end;">Tải ảnh lên Cloudinary</button>
          </div>
          <label class="wide">Mô tả ngắn
            <input name="shortDescription" placeholder="Mô tả tóm tắt hiển thị trên card sản phẩm và SEO">
          </label>
          <label class="wide">Mô tả chi tiết
            <textarea name="description" rows="4" placeholder="Mô tả chi tiết về phom dáng, chất vải, cách bảo quản và phối đồ..."></textarea>
          </label>
          <label>Tiêu đề SEO
            <input name="seoTitle" maxlength="160" placeholder="Tiêu đề hiển thị trên Google">
          </label>
          <label>Mô tả SEO
            <input name="seoDescription" maxlength="320" placeholder="Mô tả tóm tắt cho công cụ tìm kiếm">
          </label>

          <!-- Variant Editor -->
          <section class="variant-editor wide" aria-labelledby="variantHeading">
            <div class="variant-editor-heading">
              <div>
                <h3 id="variantHeading">Phân loại kích cỡ / màu sắc & Tồn kho biến thể</h3>
                <p class="muted">Tạo các tổ hợp kích cỡ (S, M, L, XL) và màu sắc kèm số lượng tồn kho tương ứng.</p>
              </div>
              <button class="admin-button" id="addVariant" type="button">+ Thêm biến thể</button>
            </div>
            <div id="variantRows" class="variant-rows"></div>
          </section>

          <label>Trạng thái kinh doanh
            <select name="productStatus">
              <option value="PUBLISHED">Đang hiển thị và kinh doanh (PUBLISHED)</option>
              <option value="DRAFT">Bản nháp - Chưa công khai (DRAFT)</option>
              <option value="INACTIVE">Ngừng kinh doanh (INACTIVE)</option>
            </select>
          </label>
          <div style="display: flex; gap: 20px; align-items: center;">
            <label class="check-label"><input name="isFeatured" type="checkbox" value="true"> Sản phẩm nổi bật</label>
            <label class="check-label"><input name="isNewArrival" type="checkbox" value="true"> Hàng mới về</label>
          </div>
        </div>

        <div class="admin-actions">
          <button class="admin-button primary" id="submitProductBtn" type="submit">Lưu sản phẩm</button>
          <button class="admin-button" id="cancelProduct" type="button">Hủy / Làm mới form</button>
        </div>
      </form>
    </section>

    <!-- Danh sách sản phẩm -->
    <section class="admin-panel">
      <div class="table-heading" style="flex-wrap: wrap; gap: 14px;">
        <div>
          <h2>Danh sách Áo Dài (<span id="totalProductsCount">0</span>)</h2>
          <p class="muted" style="margin: 2px 0 0; font-size: 13px;">Bạn có thể chỉnh sửa tồn kho trực tiếp ngay tại cột [Tồn kho] bên dưới.</p>
        </div>
        <div class="product-list-filters" style="display: flex; flex-wrap: wrap; gap: 8px;">
          <select id="statusFilter" aria-label="Lọc theo trạng thái kinh doanh">
            <option value="all">Tất cả trạng thái</option>
            <option value="PUBLISHED">Đang kinh doanh</option>
            <option value="INACTIVE">Ngừng kinh doanh</option>
            <option value="DRAFT">Bản nháp</option>
          </select>
          <select id="stockFilter" aria-label="Lọc theo tồn kho">
            <option value="all">Mọi mức tồn kho</option>
            <option value="in_stock">Còn hàng (> 10)</option>
            <option value="low">Sắp hết hàng (1–10)</option>
            <option value="out">Hết hàng (0)</option>
          </select>
          <input id="productSearch" type="search" placeholder="Tìm tên, SKU..." style="min-width: 220px;" aria-label="Tìm kiếm sản phẩm">
        </div>
      </div>

      <div class="table-wrap">
        <table class="products-table">
          <thead>
            <tr>
              <th>Hình ảnh</th>
              <th>Tên sản phẩm</th>
              <th>Mã SKU</th>
              <th>Chất liệu & Kiểu dáng</th>
              <th>Giá bán</th>
              <th>Tồn kho (Sửa trực tiếp)</th>
              <th>Trạng thái</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody id="productRows">
            <tr><td colspan="8" style="text-align: center; padding: 32px 0;">Đang tải danh sách sản phẩm...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Delete Confirmation Modal Dialog -->
  <div id="deleteModal" class="admin-modal-backdrop" hidden>
    <div class="admin-modal-content" role="dialog" aria-labelledby="modalTitle" aria-modal="true">
      <div class="admin-modal-header">
        <h3 id="modalTitle">Xác nhận xóa sản phẩm</h3>
      </div>
      <div class="admin-modal-body">
        <p>Bạn có chắc chắn muốn xóa sản phẩm sau khỏi hệ thống?</p>
        <p style="margin: 10px 0; font-size: 15px;">
          Tên sản phẩm: <strong id="deleteModalName">—</strong><br>
          Mã SKU: <code id="deleteModalSku">—</code>
        </p>
        <p class="muted" style="font-size: 13px; line-height: 1.4; background: #fff8e6; padding: 10px; border-radius: 8px; border-left: 3px solid #f59e0b;">
          <strong>Chính sách dữ liệu:</strong><br>
          • Nếu sản phẩm chưa từng có trong đơn hàng: Sẽ được xóa vĩnh viễn khỏi database.<br>
          • Nếu sản phẩm đã từng phát sinh đơn hàng: Hệ thống tự động chuyển sang trạng thái <strong>"Ngừng kinh doanh"</strong> để bảo toàn lịch sử hóa đơn khách hàng.
        </p>
      </div>
      <div class="admin-modal-actions">
        <button type="button" class="admin-button" id="cancelDeleteModal">Hủy bỏ</button>
        <button type="button" class="admin-button danger" id="confirmDeleteModal" style="background: #dc2626; color: #fff; border-color: #dc2626;">Xác nhận xóa</button>
      </div>
    </div>
  </div>

  <script src="/js/admin.js"></script>
  <script>
    (() => {
      const form = document.getElementById('productForm');
      const rows = document.getElementById('productRows');
      const notice = document.getElementById('productNotice');
      const variantRows = document.getElementById('variantRows');
      const totalCountSpan = document.getElementById('totalProductsCount');
      const formTitle = document.getElementById('productFormTitle');
      const formEyebrow = document.getElementById('formEyebrow');
      const submitBtn = document.getElementById('submitProductBtn');

      // Modal elements
      const deleteModal = document.getElementById('deleteModal');
      const deleteModalName = document.getElementById('deleteModalName');
      const deleteModalSku = document.getElementById('deleteModalSku');
      const confirmDeleteModal = document.getElementById('confirmDeleteModal');
      const cancelDeleteModal = document.getElementById('cancelDeleteModal');
      let pendingDeleteId = null;

      let products = [];

      function showNotice(text, isError = false) {
        notice.hidden = false;
        notice.textContent = text;
        notice.className = `notice${isError ? ' error' : ''}`;
        notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        setTimeout(() => {
          if (!isError && notice.textContent === text) notice.hidden = true;
        }, 5000);
      }

      function addVariantRow(variant = {}) {
        const row = document.createElement('div');
        row.className = 'variant-row';
        row.dataset.id = variant._id || '';

        const fields = [
          ['size', 'Kích cỡ', variant.size || ''],
          ['color', 'Màu sắc', variant.color || ''],
          ['sku', 'SKU biến thể', variant.sku || '']
        ];
        fields.forEach(([key, label, value]) => {
          const wrap = document.createElement('label');
          wrap.textContent = label;
          const input = document.createElement('input');
          input.dataset.variant = key;
          input.value = value;
          if (key === 'sku') input.maxLength = 80;
          wrap.appendChild(input);
          row.appendChild(wrap);
        });

        const stockLabel = document.createElement('label');
        stockLabel.textContent = 'Tồn kho';
        const stockInput = document.createElement('input');
        stockInput.dataset.variant = 'stock';
        stockInput.type = 'number';
        stockInput.min = '0';
        stockInput.step = '1';
        stockInput.value = variant.stock ?? 0;
        stockLabel.appendChild(stockInput);
        row.appendChild(stockLabel);

        const adjustmentLabel = document.createElement('label');
        adjustmentLabel.textContent = 'Điều chỉnh giá';
        const adjustment = document.createElement('input');
        adjustment.dataset.variant = 'priceAdjustment';
        adjustment.type = 'number';
        adjustment.step = '1';
        adjustment.value = variant.priceAdjustment ?? 0;
        adjustmentLabel.appendChild(adjustment);
        row.appendChild(adjustmentLabel);

        const availability = document.createElement('label');
        availability.className = 'variant-availability';
        const available = document.createElement('input');
        available.dataset.variant = 'available';
        available.type = 'checkbox';
        available.checked = variant.available !== false;
        availability.append(available, document.createTextNode(' Đang bán'));
        row.appendChild(availability);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'table-action danger';
        remove.textContent = 'Xóa';
        remove.addEventListener('click', () => {
          row.remove();
          syncStockMode();
        });
        row.appendChild(remove);

        stockInput.addEventListener('input', syncStockMode);
        variantRows.appendChild(row);
        syncStockMode();
      }

      function syncStockMode() {
        const hasVariants = variantRows.children.length > 0;
        const total = [...variantRows.querySelectorAll('[data-variant="stock"]')].reduce((sum, input) => sum + (Number(input.value) || 0), 0);
        form.elements.stock.readOnly = hasVariants;
        if (hasVariants) form.elements.stock.value = String(total);
      }

      function setVariants(items) {
        variantRows.replaceChildren();
        (items || []).forEach(addVariantRow);
        syncStockMode();
      }

      function collectVariants() {
        return [...variantRows.children].map(row => {
          const value = key => row.querySelector(`[data-variant="${key}"]`);
          return {
            ...(row.dataset.id ? { _id: row.dataset.id } : {}),
            size: value('size').value.trim(),
            color: value('color').value.trim(),
            sku: value('sku').value.trim(),
            stock: Number(value('stock').value),
            priceAdjustment: Number(value('priceAdjustment').value || 0),
            available: value('available').checked
          };
        });
      }

      function resetForm() {
        form.reset();
        form.elements.id.value = '';
        form.elements.stock.value = '0';
        form.elements.stock.readOnly = false;
        formTitle.textContent = 'Thêm sản phẩm mới';
        formEyebrow.textContent = 'PRODUCT DETAILS';
        submitBtn.textContent = 'Lưu sản phẩm';
        setVariants([]);
      }

      function render() {
        rows.replaceChildren();
        totalCountSpan.textContent = String(products.length);

        if (!products.length) {
          rows.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 32px 0; color: var(--admin-muted);">Không tìm thấy sản phẩm nào phù hợp với bộ lọc hiện tại.</td></tr>';
          return;
        }

        products.forEach(p => {
          const tr = document.createElement('tr');
          tr.dataset.productId = p._id;

          // 1. Hình ảnh & Tên sản phẩm
          const nameCell = document.createElement('td');
          nameCell.className = 'product-name-cell';
          if (p.image) {
            const img = document.createElement('img');
            img.src = p.image;
            img.alt = p.name;
            nameCell.appendChild(img);
          }
          const title = document.createElement('span');
          title.textContent = p.name;
          title.style.fontWeight = '600';
          nameCell.appendChild(title);
          tr.appendChild(nameCell);

          // 2. SKU
          const skuCell = document.createElement('td');
          skuCell.setAttribute('data-label', 'Mã SKU');
          skuCell.innerHTML = `<code>${p.sku || '—'}</code>`;
          tr.appendChild(skuCell);

          // 3. Chất liệu & Kiểu dáng
          const styleCell = document.createElement('td');
          styleCell.setAttribute('data-label', 'Chất liệu & Kiểu dáng');
          const styleInfo = [p.material, p.designStyle].filter(Boolean).join(' · ') || 'Áo dài cách tân';
          styleCell.textContent = styleInfo;
          tr.appendChild(styleCell);

          // 4. Giá bán
          const priceCell = document.createElement('td');
          priceCell.setAttribute('data-label', 'Giá bán');
          const activePrice = Number(p.salePrice ?? p.price);
          priceCell.innerHTML = `<strong>${activePrice.toLocaleString('vi-VN')} ₫</strong>`;
          if (p.originalPrice && p.originalPrice > activePrice) {
            priceCell.innerHTML += `<br><small class="muted" style="text-decoration: line-through;">${Number(p.originalPrice).toLocaleString('vi-VN')} ₫</small>`;
          }
          tr.appendChild(priceCell);

          // 5. Tồn kho (Chỉnh sửa trực tiếp tại bảng)
          const stockCell = document.createElement('td');
          stockCell.setAttribute('data-label', 'Tồn kho');
          const currentStock = Number(p.stock || 0);

          let stockClass = 'in-stock';
          let stockLabel = 'Còn hàng';
          if (currentStock <= 0) {
            stockClass = 'out-of-stock';
            stockLabel = 'Hết hàng';
          } else if (currentStock <= 10) {
            stockClass = 'low-stock';
            stockLabel = 'Sắp hết';
          }

          const stockWrap = document.createElement('div');
          stockWrap.className = 'inline-stock-box';

          const stockInput = document.createElement('input');
          stockInput.type = 'number';
          stockInput.min = '0';
          stockInput.step = '1';
          stockInput.className = 'inline-stock-input';
          stockInput.value = String(currentStock);
          stockInput.dataset.prev = String(currentStock);
          stockInput.setAttribute('aria-label', `Tồn kho sản phẩm ${p.name}`);

          const saveBtn = document.createElement('button');
          saveBtn.type = 'button';
          saveBtn.className = 'inline-stock-save';
          saveBtn.innerHTML = '✓';
          saveBtn.title = 'Lưu thay đổi tồn kho';

          const stockPill = document.createElement('span');
          stockPill.className = `stock-pill ${stockClass}`;
          stockPill.textContent = stockLabel;

          // Inline stock update handler
          async function commitStockUpdate() {
            const val = stockInput.value.trim();
            const num = Number(val);
            if (!Number.isInteger(num) || num < 0) {
              showNotice('Số lượng tồn kho phải là số nguyên không âm (≥ 0).', true);
              stockInput.value = stockInput.dataset.prev;
              return;
            }
            if (num === Number(stockInput.dataset.prev)) {
              return; // Không thay đổi
            }

            stockInput.disabled = true;
            saveBtn.disabled = true;

            try {
              const res = await fetch(`/api/admin/products/${p._id}/stock`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ stock: num })
              });
              const data = await res.json();
              if (!res.ok || !data.ok) throw new Error(data.message || 'Cập nhật tồn kho thất bại.');

              stockInput.dataset.prev = String(data.stock);
              stockInput.value = String(data.stock);
              p.stock = data.stock;

              // Update badge
              if (data.stock <= 0) {
                stockPill.className = 'stock-pill out-of-stock';
                stockPill.textContent = 'Hết hàng';
              } else if (data.stock <= 10) {
                stockPill.className = 'stock-pill low-stock';
                stockPill.textContent = 'Sắp hết';
              } else {
                stockPill.className = 'stock-pill in-stock';
                stockPill.textContent = 'Còn hàng';
              }

              showNotice(`Đã cập nhật tồn kho "${p.name}" thành ${data.stock} sản phẩm.`);
            } catch (err) {
              stockInput.value = stockInput.dataset.prev;
              showNotice(err.message, true);
            } finally {
              stockInput.disabled = false;
              saveBtn.disabled = false;
            }
          }

          saveBtn.addEventListener('click', commitStockUpdate);
          stockInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              commitStockUpdate();
            } else if (e.key === 'Escape') {
              stockInput.value = stockInput.dataset.prev;
              stockInput.blur();
            }
          });

          stockWrap.append(stockInput, saveBtn, stockPill);
          stockCell.appendChild(stockWrap);
          tr.appendChild(stockCell);

          // 6. Trạng thái
          const statusCell = document.createElement('td');
          statusCell.setAttribute('data-label', 'Trạng thái');
          let statusBadge = '<span class="status-pill published">● Đang kinh doanh</span>';
          if (p.productStatus === 'DRAFT') {
            statusBadge = '<span class="status-pill draft">○ Bản nháp</span>';
          } else if (p.productStatus === 'INACTIVE' || p.productStatus === 'ARCHIVED' || p.productStatus === 'UNPUBLISHED') {
            statusBadge = '<span class="status-pill inactive">■ Ngừng kinh doanh</span>';
          }
          statusCell.innerHTML = statusBadge;
          tr.appendChild(statusCell);

          // 7. Thao tác (Sửa, Xóa)
          const actionsCell = document.createElement('td');
          actionsCell.className = 'product-actions-cell';
          actionsCell.setAttribute('data-label', 'Thao tác');

          const editBtn = document.createElement('button');
          editBtn.type = 'button';
          editBtn.className = 'table-action';
          editBtn.textContent = 'Sửa';
          editBtn.addEventListener('click', () => {
            form.elements.id.value = p._id;
            ['name', 'slug', 'productCode', 'sku', 'price', 'originalPrice', 'salePrice', 'stock', 'brand', 'material', 'designStyle', 'image', 'shortDescription', 'description', 'seoTitle', 'seoDescription'].forEach(key => {
              if (form.elements[key]) form.elements[key].value = p[key] ?? '';
            });

            // Map productStatus
            const validStatus = ['PUBLISHED', 'DRAFT', 'INACTIVE'].includes(p.productStatus) ? p.productStatus : 'INACTIVE';
            form.elements.productStatus.value = validStatus;

            form.elements.tags.value = (p.tags || []).join(', ');
            setVariants(p.variants || []);
            form.elements.isFeatured.checked = Boolean(p.isFeatured);
            form.elements.isNewArrival.checked = Boolean(p.isNewArrival);

            formTitle.textContent = `Chỉnh sửa: ${p.name}`;
            formEyebrow.textContent = 'EDIT PRODUCT';
            submitBtn.textContent = 'Cập nhật sản phẩm';
            document.getElementById('productFormPanel').scrollIntoView({ behavior: 'smooth' });
          });

          const deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.className = 'table-action danger';
          deleteBtn.textContent = 'Xóa';
          deleteBtn.addEventListener('click', () => {
            pendingDeleteId = p._id;
            deleteModalName.textContent = p.name;
            deleteModalSku.textContent = p.sku || 'N/A';
            deleteModal.hidden = false;
          });

          actionsCell.append(editBtn, deleteBtn);
          tr.appendChild(actionsCell);

          rows.appendChild(tr);
        });
      }

      // Modal action handlers
      cancelDeleteModal.addEventListener('click', () => {
        deleteModal.hidden = true;
        pendingDeleteId = null;
      });

      confirmDeleteModal.addEventListener('click', async () => {
        if (!pendingDeleteId) return;
        confirmDeleteModal.disabled = true;
        try {
          const res = await fetch(`/api/admin/products/${pendingDeleteId}`, { method: 'DELETE' });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.message || 'Xóa sản phẩm thất bại.');
          showNotice(data.message);
          deleteModal.hidden = true;
          pendingDeleteId = null;
          await loadProducts();
        } catch (err) {
          showNotice(err.message, true);
        } finally {
          confirmDeleteModal.disabled = false;
        }
      });

      async function loadProducts() {
        const q = document.getElementById('productSearch').value.trim();
        const stockStatus = document.getElementById('stockFilter').value;
        const status = document.getElementById('statusFilter').value;

        try {
          const res = await fetch(`/api/admin/products?q=${encodeURIComponent(q)}&stockStatus=${encodeURIComponent(stockStatus)}&status=${encodeURIComponent(status)}&limit=100`);
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.message || 'Không thể tải danh sách sản phẩm.');
          products = data.items || [];
          render();
        } catch (err) {
          showNotice(err.message, true);
        }
      }

      // Form submission (Add / Update)
      form.addEventListener('submit', async e => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form));
        const id = data.id;
        delete data.id;

        data.isFeatured = form.elements.isFeatured.checked;
        data.isNewArrival = form.elements.isNewArrival.checked;
        data.variants = collectVariants();

        submitBtn.disabled = true;
        try {
          const res = await fetch(id ? `/api/admin/products/${id}` : '/api/admin/products', {
            method: id ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await res.json();
          if (!res.ok || !result.ok) throw new Error(result.message || 'Lỗi khi lưu sản phẩm.');

          showNotice(result.message || (id ? 'Đã cập nhật sản phẩm.' : 'Đã tạo sản phẩm mới thành công.'));
          resetForm();
          await loadProducts();
        } catch (err) {
          showNotice(err.message, true);
        } finally {
          submitBtn.disabled = false;
        }
      });

      // Upload image to Cloudinary
      document.getElementById('uploadProductImage').addEventListener('click', async () => {
        const file = document.getElementById('productImageFile').files[0];
        if (!file) return showNotice('Vui lòng chọn một ảnh JPEG, PNG hoặc WebP trước.', true);
        if (file.size > 5 * 1024 * 1024) return showNotice('Tệp ảnh phải nhỏ hơn 5 MB.', true);

        const dataUrl = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result);
          reader.onerror = () => reject(new Error('Không thể đọc tệp ảnh.'));
          reader.readAsDataURL(file);
        }).catch(err => {
          showNotice(err.message, true);
          return null;
        });

        if (!dataUrl) return;

        const uploadBtn = document.getElementById('uploadProductImage');
        uploadBtn.disabled = true;
        uploadBtn.textContent = 'Đang tải lên...';

        try {
          const res = await fetch('/api/admin/images', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dataUrl })
          });
          const result = await res.json();
          if (!res.ok || !result.ok) throw new Error(result.message || 'Không thể tải ảnh lên Cloudinary.');
          form.elements.image.value = result.image;
          showNotice('Đã tải ảnh lên Cloudinary thành công. URL đã được điền vào form.');
        } catch (err) {
          showNotice(err.message, true);
        } finally {
          uploadBtn.disabled = false;
          uploadBtn.textContent = 'Tải ảnh lên Cloudinary';
        }
      });

      // Events
      document.getElementById('newProduct').addEventListener('click', () => {
        resetForm();
        document.getElementById('productFormPanel').scrollIntoView({ behavior: 'smooth' });
      });

      document.getElementById('cancelProduct').addEventListener('click', resetForm);
      document.getElementById('addVariant').addEventListener('click', () => addVariantRow());
      document.getElementById('stockFilter').addEventListener('change', loadProducts);
      document.getElementById('statusFilter').addEventListener('change', loadProducts);

      document.getElementById('productSearch').addEventListener('input', () => {
        clearTimeout(window.productSearchTimer);
        window.productSearchTimer = setTimeout(loadProducts, 200);
      });

      loadProducts();
    })();
  </script>
</body>
</html>
