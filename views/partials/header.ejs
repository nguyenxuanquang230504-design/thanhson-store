<header class="tsf-header">
  <div class="announcement-bar">
    THANH SƠN STORE — CHUYÊN ÁO DÀI CÁCH TÂN CAO CẤP <span>•</span> MIỄN PHÍ VẬN CHUYỂN TOÀN QUỐC CHO ĐƠN TỪ 500.000₫
  </div>

  <div class="tsf-container tsf-nav">
    <button class="menu-toggle" type="button" aria-label="Mở menu điều hướng" aria-expanded="false" aria-controls="mobileMenuOverlay">
      <span></span><span></span><span></span>
    </button>

    <div class="tsf-logo">
      <a href="/" aria-label="Thanh Sơn Store — Trang chủ">
        Thanh Sơn <span>Fashion</span>
        <small class="store-tagline">Chuyên Áo Dài Cách Tân</small>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="tsf-menu" aria-label="Điều hướng chính">
      <a href="/">Trang chủ</a>
      <a href="/san-pham">Tất cả áo dài</a>
      <a href="/san-pham?collection=true">Bộ sưu tập</a>
      <a href="/san-pham?sort=newest">Sản phẩm mới</a>
      <a href="/san-pham?sale=true">Khuyến mãi</a>
    </nav>

    <!-- Header Actions & Search -->
    <div class="tsf-icons">
      <form class="search-form live-search" action="/tim-kiem" method="get" role="search">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
        <input type="search" name="q" placeholder="Tìm kiếm mẫu áo dài cách tân..." aria-label="Tìm kiếm mẫu áo dài cách tân..." autocomplete="off" aria-controls="desktopSuggestions">
        <button class="search-clear" type="button" aria-label="Xóa nội dung tìm kiếm" hidden>×</button>
        <button class="icon-btn search-submit" type="submit" title="Tìm kiếm" aria-label="Tìm kiếm">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>
        <div id="desktopSuggestions" class="search-suggestions" role="listbox" hidden></div>
      </form>

      <a class="icon-btn header-action" href="/yeu-thich" title="Danh sách yêu thích" aria-label="Yêu thích">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 8.7c0 5.2-8.8 10.1-8.8 10.1S3.2 13.9 3.2 8.7a4.7 4.7 0 0 1 8.8-2.2 4.7 4.7 0 0 1 8.8 2.2Z"></path></svg>
        <span class="badge" data-badge="wishlist"><%= badges.wishlist %></span>
      </a>

      <a class="icon-btn header-action" href="/gio-hang" title="Giỏ hàng" aria-label="Giỏ hàng">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 8h14l1 12H4L5 8Z"></path><path d="M9 8a3 3 0 0 1 6 0"></path></svg>
        <span class="badge" data-badge="cart"><%= badges.cart %></span>
      </a>

      <% if (currentUser) { %>
        <a class="login-link" href="/tai-khoan" title="Tài khoản cá nhân">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"></circle><path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path></svg>
          <span><%= currentUser.fullName || currentUser.username %></span>
        </a>
      <% } else { %>
        <a class="login-link" href="/dang-nhap" title="Đăng nhập tài khoản">
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"></circle><path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path></svg>
          <span>Tài khoản</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Mobile Search Bar (inline under header) -->
  <div class="mobile-search-row">
    <form class="mobile-search live-search" action="/tim-kiem" method="get" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
      <input type="search" name="q" placeholder="Tìm mẫu áo dài cách tân..." aria-label="Tìm mẫu áo dài cách tân..." autocomplete="off" aria-controls="mobileSuggestions">
      <button class="search-clear" type="button" aria-label="Xóa nội dung tìm kiếm" hidden>×</button>
      <button type="submit" aria-label="Tìm kiếm">Tìm</button>
      <div id="mobileSuggestions" class="search-suggestions" role="listbox" hidden></div>
    </form>
  </div>

  <!-- Full-Screen Mobile Navigation Overlay (Redesigned per Section 12) -->
  <div id="mobileMenuOverlay" class="mobile-nav-overlay" aria-hidden="true" inert>
    <div class="mobile-nav-dialog" role="dialog" aria-modal="true" aria-label="Menu điều hướng di động">
      <!-- Overlay Header -->
      <div class="mobile-nav-header">
        <div class="mobile-nav-brand">
          <strong>Thanh Sơn <span>Fashion</span></strong>
          <small>Chuyên Áo Dài Cách Tân</small>
        </div>
        <button class="mobile-nav-close" type="button" aria-label="Đóng menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Quick Shortcuts (Wishlist & Cart) -->
      <div class="mobile-nav-shortcuts">
        <a href="/yeu-thich" class="mobile-shortcut-btn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.7c0 5.2-8.8 10.1-8.8 10.1S3.2 13.9 3.2 8.7a4.7 4.7 0 0 1 8.8-2.2 4.7 4.7 0 0 1 8.8 2.2Z"></path></svg>
          <span>Yêu thích (<span data-badge="wishlist"><%= badges.wishlist %></span>)</span>
        </a>
        <a href="/gio-hang" class="mobile-shortcut-btn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 12H4L5 8Z"></path><path d="M9 8a3 3 0 0 1 6 0"></path></svg>
          <span>Giỏ hàng (<span data-badge="cart"><%= badges.cart %></span>)</span>
        </a>
      </div>

      <!-- 8 Mandatory Primary Menu Items -->
      <nav class="mobile-nav-menu" aria-label="Menu điều hướng di động">
        <a href="/" class="mobile-nav-link">
          <span class="nav-num">01</span>
          <span class="nav-text">Trang chủ</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/san-pham" class="mobile-nav-link">
          <span class="nav-num">02</span>
          <span class="nav-text">Tất cả áo dài</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/san-pham?collection=true" class="mobile-nav-link">
          <span class="nav-num">03</span>
          <span class="nav-text">Bộ sưu tập</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/san-pham?sort=newest" class="mobile-nav-link">
          <span class="nav-num">04</span>
          <span class="nav-text">Sản phẩm mới</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/san-pham?sale=true" class="mobile-nav-link">
          <span class="nav-num">05</span>
          <span class="nav-text">Khuyến mãi</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/yeu-thich" class="mobile-nav-link">
          <span class="nav-num">06</span>
          <span class="nav-text">Sản phẩm yêu thích</span>
          <span class="nav-badge"><%= badges.wishlist %></span>
        </a>
        <a href="/gio-hang" class="mobile-nav-link">
          <span class="nav-num">07</span>
          <span class="nav-text">Giỏ hàng của bạn</span>
          <span class="nav-badge"><%= badges.cart %></span>
        </a>
        <a href="<%= currentUser ? '/tai-khoan' : '/dang-nhap' %>" class="mobile-nav-link highlight">
          <span class="nav-num">08</span>
          <span class="nav-text"><%= currentUser ? `Tài khoản (${currentUser.fullName || currentUser.username})` : 'Tài khoản / Đăng nhập' %></span>
          <span class="nav-arrow">→</span>
        </a>
      </nav>

      <!-- Overlay Footer -->
      <div class="mobile-nav-footer">
        <p class="brand-commit">THANH SƠN STORE — NÂNG TẦM ÁO DÀI VIỆT</p>
        <p class="contact-info">Hotline hỗ trợ: <a href="tel:0937685789">0937 685 789</a></p>
      </div>
    </div>
  </div>
</header>
