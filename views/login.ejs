<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title><%= currentUser ? 'Tài khoản của bạn' : 'Đăng nhập' %> | Thanh Sơn Store</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/style.css?v=20261124">
</head>
<body>
  <%- include('partials/header') %>

  <section class="tsf-container">
    <div class="auth-shell <%= currentUser ? 'profile-shell' : '' %>">
      <h2><%= currentUser ? 'Tài khoản của bạn' : 'Đăng nhập' %></h2>

      <% if (message) { %>
        <div class="success-msg"><%= message %></div>
      <% } %>

      <% if (currentUser) { %>
        <!-- Member status & benefit notice -->
        <div class="member-banner">
          <span class="member-tag">THÀNH VIÊN THANH SƠN</span>
          <p>Tài khoản thành viên được giảm giá <strong>15%</strong> tự động trên mọi đơn hàng áo dài cách tân.</p>
        </div>

        <!-- Account Profile Form -->
        <form id="profileForm" class="form-grid">
          <div class="form-group">
            <label for="profFullName">Họ và tên</label>
            <input id="profFullName" name="fullName" value="<%= currentUser.fullName || '' %>" required>
          </div>
          <div class="form-group">
            <label for="profPhone">Số điện thoại</label>
            <input id="profPhone" name="phone" type="tel" value="<%= currentUser.phone || '' %>" required>
          </div>
          <div class="form-group">
            <label for="profUsername">Tên đăng nhập (Username)</label>
            <input id="profUsername" value="<%= currentUser.username %>" disabled>
          </div>
          <div class="form-group">
            <label for="profEmail">Email</label>
            <input id="profEmail" name="email" type="email" value="<%= currentUser.email || '' %>" placeholder="name@example.com">
          </div>
          <div class="form-group full-width">
            <label for="profAddress">Địa chỉ nhận hàng mặc định</label>
            <textarea id="profAddress" name="address" rows="2" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố"><%= currentUser.address || '' %></textarea>
          </div>
          <div class="form-actions">
            <button class="btn" type="submit">Lưu thông tin</button>
            <button class="btn-outline" id="logoutBtn" type="button">Đăng xuất</button>
          </div>
        </form>

        <!-- Customer Order History -->
        <section class="customer-orders-section">
          <h3>Lịch sử đơn hàng của bạn</h3>
          <% if (typeof orders !== 'undefined' && orders && orders.length) { %>
            <div class="table-wrap">
              <table class="user-orders-table">
                <thead>
                  <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Sản phẩm</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thanh toán</th>
                    <th>Chi tiết</th>
                  </tr>
                </thead>
                <tbody>
                  <% orders.forEach(o => { %>
                    <tr>
                      <td><strong><%= o.id %></strong></td>
                      <td><%= new Date(o.createdAt).toLocaleDateString('vi-VN') %></td>
                      <td>
                        <% (o.items || []).forEach(it => { %>
                          <div><%= it.name %> x<%= it.qty %></div>
                        <% }) %>
                      </td>
                      <td><strong><%= Number(o.totalAmount || 0).toLocaleString('vi-VN') %> ₫</strong></td>
                      <td>
                        <span class="status-badge <%= o.status %>">
                          <%= ({ pending: 'Chờ tiếp nhận', confirmed: 'Đã xác nhận', processing: 'Đang chuẩn bị', shipped: 'Đang giao', delivered: 'Đã giao', cancelled: 'Đã hủy' })[o.status] || o.status %>
                        </span>
                      </td>
                      <td>
                        <span class="pay-badge <%= o.paymentStatus %>">
                          <%= ({ pending: 'Chờ thanh toán', paid: 'Đã thanh toán', unpaid: 'Chưa thanh toán (COD)', cancelled: 'Đã hủy' })[o.paymentStatus] || o.paymentStatus %>
                        </span>
                      </td>
                      <td>
                        <a href="/don-hang?id=<%= encodeURIComponent(o.id) %>" class="text-link">Xem đơn →</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-orders-note">
              <p>Bạn chưa có đơn hàng nào.</p>
              <a href="/san-pham" class="btn">Khám phá các mẫu áo dài ngay</a>
            </div>
          <% } %>
        </section>

      <% } else { %>
        <!-- Login Form -->
        <form id="loginForm" class="form-grid">
          <div class="form-group">
            <label for="loginUsername">Tên đăng nhập hoặc SĐT</label>
            <input id="loginUsername" type="text" name="username" placeholder="Nhập username" required>
          </div>
          <div class="form-group">
            <label for="loginPassword">Mật khẩu</label>
            <input id="loginPassword" type="password" name="password" placeholder="Nhập mật khẩu" required>
          </div>
          <div class="form-actions">
            <button class="btn" type="submit">Đăng nhập</button>
          </div>
          <p class="auth-switch">Chưa có tài khoản? <a href="/dang-ky">Đăng ký thành viên (Giảm ngay 15%)</a></p>
        </form>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    const loginForm = document.getElementById('loginForm');
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = new FormData(loginForm);
        const payload = Object.fromEntries(form.entries());

        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await res.json();
        if (!result.ok) {
          if (result.isAdmin && result.redirect) {
            window.location.href = result.redirect;
            return;
          }
          alert(result.message || 'Đăng nhập thất bại.');
          return;
        }

        if (result.isAdmin && result.redirect) {
          window.location.href = result.redirect;
          return;
        }

        window.location.href = '/tai-khoan';
      });
    }

    const profileForm = document.getElementById('profileForm');
    if (profileForm) {
      profileForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = new FormData(profileForm);
        const payload = Object.fromEntries(form.entries());

        try {
          const res = await fetch('/api/auth/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await res.json();
          if (!res.ok) throw new Error(result.message || 'Không thể lưu thông tin.');
          alert(result.message || 'Đã lưu thông tin tài khoản thành công!');
        } catch (err) {
          alert(err.message);
        }
      });
    }

    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/';
      });
    }
  </script>
</body>
</html>
