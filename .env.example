NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL. Leave unset to use local JSON files for development only.
DATABASE_URL=postgresql://user:password@localhost:5432/thanhson_store
PGSSL=require
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/thanhson_store?retryWrites=true&w=majority&appName=Cluster0
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/thanhson_store
ADMIN_EMAIL=admin@thanhson.local
ADMIN_PASSWORD=
LOW_STOCK_THRESHOLD=10
VERY_LOW_STOCK_THRESHOLD=5
BANK_TRANSFER_EXPIRY_HOURS=24

# Optional VietQR transfer details
PAYMENT_BANK_ID=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
