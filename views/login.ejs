<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title>Đăng nhập | Thanh Sơn Fashion</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/style.css?v=20261124">
</head>
<body>
  <%- include('partials/header') %>

  <section class="tsf-container">
    <div class="auth-shell">
      <h2><%= currentUser ? 'Tài khoản của bạn' : 'Đăng nhập' %></h2>

      <% if (message) { %>
        <div class="error-msg"><%= message %></div>
      <% } %>

      <% if (currentUser) { %>
        <div class="form-grid">
          <div class="form-group">
            <label>Họ tên</label>
            <input value="<%= currentUser.fullName %>" disabled>
          </div>
          <div class="form-group">
            <label>Username</label>
            <input value="<%= currentUser.username %>" disabled>
          </div>
          <div class="form-group">
            <label>Số điện thoại</label>
            <input value="<%= currentUser.phone || '' %>" disabled>
          </div>
          <div class="form-actions">
            <button class="btn" id="logoutBtn">Đăng xuất</button>
          </div>
        </div>
      <% } else { %>
        <form id="loginForm" class="form-grid">
          <div class="form-group">
            <label>Tên đăng nhập</label>
            <input type="text" name="username" required>
          </div>
          <div class="form-group">
            <label>Mật khẩu</label>
            <input type="password" name="password" required>
          </div>
          <div class="form-actions">
            <button class="btn" type="submit">Đăng nhập</button>
          </div>
          <p class="auth-switch">Chưa có tài khoản? <a href="/dang-ky">Đăng ký ngay</a></p>
        </form>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    const loginForm = document.getElementById('loginForm');
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = new FormData(loginForm);
        const payload = Object.fromEntries(form.entries());

        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await res.json();
        if (!result.ok) {
          alert(result.message || 'Đăng nhập thất bại');
          return;
        }

        window.location.href = '/';
      });
    }

    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/';
      });
    }
  </script>
</body>
</html>
