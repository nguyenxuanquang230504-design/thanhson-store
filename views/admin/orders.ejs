<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Đơn hàng | Admin Thanh Sơn</title>
  <link rel="stylesheet" href="/css/admin.css?v=20261124">
</head>
<body class="admin-shell">
  <%- include('_layout', { active: 'orders' }) %>
  <main class="admin-main">
    <header class="admin-top">
      <div>
        <p class="eyebrow">FULFILLMENT & ORDERS</p>
        <h1>Quản lý đơn hàng</h1>
        <p class="muted">Tối đa 100 đơn gần nhất · Cập nhật trạng thái may, đóng gói, vận chuyển và xác nhận thanh toán.</p>
      </div>
      <a class="admin-button" href="/admin">◫ Tổng quan CMS</a>
    </header>

    <% if (locals.error) { %>
      <div class="notice error"><%= locals.error %></div>
    <% } %>
    
    <div id="orderNotice" class="notice" hidden></div>

    <% if (!locals.error) { %>
      <section class="admin-panel">
        <div class="order-filter-bar">
          <div class="order-filter-tabs" id="orderFilterTabs">
            <button class="order-filter-tab active" type="button" data-status-filter="all">Tất cả (<%= (items || []).length %>)</button>
            <button class="order-filter-tab" type="button" data-status-filter="pending">Chờ xác nhận</button>
            <button class="order-filter-tab" type="button" data-status-filter="confirmed">Đã xác nhận</button>
            <button class="order-filter-tab" type="button" data-status-filter="processing">Đang chuẩn bị</button>
            <button class="order-filter-tab" type="button" data-status-filter="shipped">Đang giao</button>
            <button class="order-filter-tab" type="button" data-status-filter="delivered">Đã giao</button>
            <button class="order-filter-tab" type="button" data-status-filter="cancelled">Đã hủy</button>
          </div>
          <div class="order-filter-search">
            <input id="orderSearch" type="search" placeholder="Tìm mã đơn, tên, SĐT khách..." aria-label="Tìm kiếm đơn hàng">
          </div>
        </div>

        <% if (!items || !items.length) { %>
          <p class="muted" style="padding: 24px 0; text-align: center;">Chưa có đơn hàng nào trong hệ thống.</p>
        <% } else { %>
          <div class="table-wrap">
            <table class="orders-table">
              <thead>
                <tr>
                  <th>Mã đơn & Ngày tạo</th>
                  <th>Thông tin khách hàng</th>
                  <th>Sản phẩm đặt may/mua</th>
                  <th>Thanh toán</th>
                  <th>Trạng thái đơn</th>
                  <th>Tổng giá trị</th>
                  <th>Thao tác xử lý</th>
                </tr>
              </thead>
              <tbody id="ordersTableBody">
                <% items.forEach(order => { %>
                  <% 
                    const statusLabels = {
                      pending: 'Chờ xác nhận',
                      confirmed: 'Đã xác nhận',
                      processing: 'Đang may / chuẩn bị',
                      shipped: 'Đang giao hàng',
                      delivered: 'Đã giao thành công',
                      cancelled: 'Đã hủy đơn',
                      failed: 'Thất bại'
                    };
                    const statusClass = order.status || 'pending';
                    const paymentMethodLabel = order.paymentMethod === 'cod' ? 'COD (Thu hộ)' : 'Chuyển khoản VietQR';
                    const paymentStatusClass = order.paymentStatus === 'paid' ? 'pay-paid' : (order.paymentStatus === 'failed' ? 'pay-failed' : 'pay-pending');
                    const paymentStatusLabel = order.paymentStatus === 'paid' ? '✓ Đã thanh toán' : (order.paymentStatus === 'failed' ? '✗ Lỗi thanh toán' : '⏳ Chờ thanh toán');
                  %>
                  <tr data-order-row="<%= order.id %>" 
                      data-status="<%= order.status %>" 
                      data-payment-method="<%= order.paymentMethod || 'bank_transfer' %>" 
                      data-payment-status="<%= order.paymentStatus || 'pending' %>"
                      data-search-text="<%= (order.id + ' ' + (order.customer?.customerName || '') + ' ' + (order.customer?.phone || '') + ' ' + (order.customer?.address || '')).toLowerCase() %>">
                    <td>
                      <strong style="font-size: 13px; color: var(--admin-ink);"><%= order.id %></strong>
                      <small style="color: var(--admin-muted);"><%= new Date(order.createdAt).toLocaleString('vi-VN') %></small>
                    </td>
                    <td>
                      <strong style="color: var(--admin-ink);"><%= order.customer?.customerName || 'Khách vãng lai' %></strong>
                      <% if (order.customer?.phone) { %>
                        <small><a href="tel:<%= order.customer.phone %>" style="color: #ec496d; font-weight: 600;">📞 <%= order.customer.phone %></a></small>
                      <% } %>
                      <% if (order.customer?.address) { %>
                        <small style="color: var(--admin-muted); line-height: 1.3;"><%= order.customer.address %></small>
                      <% } %>
                    </td>
                    <td>
                      <ul class="admin-order-items" style="list-style: none; padding-left: 0;">
                        <% (order.items || []).forEach(item => { %>
                          <li style="margin-bottom: 6px;">
                            <strong><%= item.name %></strong> × <%= item.qty %>
                            <% if (item.size || item.color) { %>
                              <br><small style="color: var(--admin-muted);">Phân loại: <%= [item.size ? ('Cỡ ' + item.size) : '', item.color].filter(Boolean).join(' · ') %></small>
                            <% } %>
                          </li>
                        <% }) %>
                      </ul>
                    </td>
                    <td>
                      <div><strong><%= paymentMethodLabel %></strong></div>
                      <span class="pay-badge <%= paymentStatusClass %>"><%= paymentStatusLabel %></span>
                    </td>
                    <td>
                      <span class="order-badge status-<%= statusClass %>"><%= statusLabels[order.status] || order.status %></span>
                    </td>
                    <td>
                      <strong style="font-size: 14px; color: #1c1c1a;"><%= Number(order.totalAmount || 0).toLocaleString('vi-VN') %> ₫</strong>
                    </td>
                    <td class="order-actions">
                      <% if (order.paymentMethod !== 'cod' && (order.paymentStatus || 'pending') === 'pending') { %>
                        <button class="table-action" type="button" data-action="payment" data-value="paid" style="background: #ecfdf5; color: #15803d; font-weight: 600;">✓ Xác nhận đã nhận tiền</button>
                        <button class="table-action danger" type="button" data-action="payment" data-value="failed">Báo thanh toán lỗi</button>
                      <% } %>
                      <% if (order.paymentMethod === 'cod' && order.status === 'delivered' && order.paymentStatus !== 'paid') { %>
                        <button class="table-action" type="button" data-action="payment" data-value="paid" style="background: #ecfdf5; color: #15803d; font-weight: 600;">✓ Đã thu tiền COD</button>
                      <% } %>
                      <% if (order.status === 'pending' && (order.paymentMethod === 'cod' || order.paymentStatus === 'paid')) { %>
                        <button class="table-action" type="button" data-action="status" data-value="confirmed" style="background: #eff6ff; color: #1d4ed8; font-weight: 600;">Xác nhận đơn</button>
                      <% } %>
                      <% if (order.status === 'confirmed') { %>
                        <button class="table-action" type="button" data-action="status" data-value="processing" style="background: #f5f3ff; color: #6d28d9; font-weight: 600;">Đang may/chuẩn bị</button>
                      <% } %>
                      <% if (order.status === 'processing') { %>
                        <button class="table-action" type="button" data-action="status" data-value="shipped" style="background: #f0fdf4; color: #166534; font-weight: 600;">Bàn giao vận chuyển</button>
                      <% } %>
                      <% if (order.status === 'shipped') { %>
                        <button class="table-action" type="button" data-action="status" data-value="delivered" style="background: #ecfdf5; color: #15803d; font-weight: 600;">Đã giao thành công</button>
                      <% } %>
                      <% if (['pending', 'confirmed', 'processing'].includes(order.status) && order.paymentStatus !== 'paid') { %>
                        <button class="table-action danger" type="button" data-action="status" data-value="cancelled">Hủy đơn</button>
                      <% } %>
                      <details class="order-audit" style="margin-top: 8px;">
                        <summary style="font-size: 11px;">Xem lịch sử luân chuyển</summary>
                        <ul style="font-size: 11px; padding-left: 14px;">
                          <% (order.statusHistory || []).forEach(event => { %>
                            <li>Trạng thái: <%= statusLabels[event.status] || event.status %> · <%= new Date(event.changedAt).toLocaleString('vi-VN') %> (<%= event.actor %>)</li>
                          <% }) %>
                          <% (order.paymentHistory || []).forEach(event => { %>
                            <li>Thanh toán: <%= event.status %> · <%= new Date(event.changedAt).toLocaleString('vi-VN') %> (<%= event.actor %>)</li>
                          <% }) %>
                          <li>Tồn kho đã trừ: <%= order.inventoryDeductedAt ? new Date(order.inventoryDeductedAt).toLocaleString('vi-VN') : 'Không' %></li>
                          <li>Tồn kho đã hoàn: <%= order.inventoryRestoredAt ? new Date(order.inventoryRestoredAt).toLocaleString('vi-VN') : 'Chưa' %></li>
                        </ul>
                      </details>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>
  </main>

  <script>
    (() => {
      // Dynamic Order Status and Payment Actions
      document.querySelectorAll('[data-order-row] [data-action]').forEach(button => {
        button.addEventListener('click', async () => {
          const row = button.closest('[data-order-row]');
          const notice = document.getElementById('orderNotice');
          const endpoint = button.dataset.action === 'payment' ? 'payment' : 'status';
          button.disabled = true;
          try {
            const response = await fetch(`/api/admin/orders/${encodeURIComponent(row.dataset.orderRow)}/${endpoint}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: button.dataset.value })
            });
            const result = await response.json();
            if (!response.ok || !result.ok) throw new Error(result.message || 'Không thể cập nhật đơn hàng.');
            window.location.reload();
          } catch (error) {
            notice.hidden = false;
            notice.classList.add('error');
            notice.textContent = error.message || 'Không thể cập nhật đơn hàng.';
            button.disabled = false;
          }
        });
      });

      // Client-side Filtering and Searching
      const searchInput = document.getElementById('orderSearch');
      const tabs = document.querySelectorAll('#orderFilterTabs .order-filter-tab');
      const rows = document.querySelectorAll('#ordersTableBody tr[data-order-row]');
      let activeFilter = 'all';

      function applyFilter() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        rows.forEach(row => {
          const status = row.dataset.status;
          const searchMatch = !query || (row.dataset.searchText || '').includes(query);
          const statusMatch = activeFilter === 'all' || status === activeFilter;
          row.style.display = (searchMatch && statusMatch) ? '' : 'none';
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', applyFilter);
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          activeFilter = tab.dataset.statusFilter;
          applyFilter();
        });
      });
    })();
  </script>
  <script src="/js/admin.js"></script>
</body>
</html>
