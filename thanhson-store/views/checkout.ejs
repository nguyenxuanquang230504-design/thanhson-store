<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title>Thanh toán | Thanh Sơn Fashion</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/style.css?v=20261124">
</head>
<body>
  <%- include('partials/header') %>

  <section class="tsf-container checkout-layout">
    <div class="checkout-box">
      <h2>Thông tin thanh toán</h2>
      <% if (user) { %>
        <div class="success-msg">Thành viên được giảm 15% trên tổng đơn hàng.</div>
      <% } else { %>
        <div class="inline-note">Bạn có thể thanh toán không cần tài khoản. Vui lòng điền đầy đủ thông tin nhận hàng.</div>
      <% } %>
      <form id="checkoutForm" class="form-grid">
        <div class="form-group">
          <label>Họ tên người nhận</label>
          <input type="text" name="customerName" required value="<%= user ? (user.fullName || user.username) : '' %>">
        </div>
        <div class="form-group">
          <label>Số điện thoại</label>
          <input type="tel" name="phone" required value="<%= user ? (user.phone || '') : '' %>">
        </div>
        <div class="form-group">
          <label>Địa chỉ giao hàng</label>
          <textarea name="address" required placeholder="Nhập địa chỉ nhận hàng"></textarea>
        </div>
        <div class="form-group">
          <label>Ghi chú</label>
          <textarea name="notes" placeholder="Ghi chú thêm nếu cần"></textarea>
        </div>
        <div class="form-group">
          <label for="paymentMethod">Phương thức thanh toán</label>
          <select id="paymentMethod" name="paymentMethod" required>
            <option value="bank_transfer">Chuyển khoản ngân hàng</option>
            <option value="cod">Thanh toán khi nhận hàng (COD)</option>
          </select>
        </div>
        <div class="form-actions">
          <button class="btn checkout-submit" type="submit">Đặt hàng</button>
          <a class="btn-outline" href="/gio-hang">Quay lại giỏ hàng</a>
        </div>
      </form>
    </div>

    <aside class="summary-box">
      <h3>Tóm tắt đơn hàng</h3>
      <ul>
        <% cart.items.forEach(item => { %>
          <li>
            <span><%= item.product.name %> x <%= item.qty %></span>
            <strong><%= item.subtotal.toLocaleString() %> ₫</strong>
          </li>
        <% }) %>
      </ul>
      <div class="summary-line">Tạm tính: <%= cart.totalAmount.toLocaleString() %> ₫</div>
      <% if (user) { %>
        <div class="summary-line discount">Giảm thành viên 15%: -<%= Math.round(cart.totalAmount * discountRate).toLocaleString() %> ₫</div>
      <% } %>
      <div class="total">Thanh toán: <%= Math.round(cart.totalAmount * (1 - discountRate)).toLocaleString() %> ₫</div>
      <div class="payment-box shop-payment" id="paymentMethodHint">
        <h3>Thanh toán an toàn</h3>
        <p>Thông tin chuyển khoản và mã QR sẽ được cung cấp sau khi đơn hàng được tiếp nhận.</p>
        <p class="inline-note">Đơn hàng chỉ được xác nhận thanh toán sau khi shop kiểm tra giao dịch.</p>
      </div>
    </aside>
  </section>

  <%- include('partials/footer') %>

  <script>
    let checkoutIdempotencyKey = crypto.randomUUID
      ? crypto.randomUUID()
      : `${Date.now()}-${Math.random().toString(36).slice(2)}`;

    const paymentMethod = document.getElementById('paymentMethod');
    const paymentHint = document.getElementById('paymentMethodHint');
    paymentMethod.addEventListener('change', () => {
      paymentHint.innerHTML = paymentMethod.value === 'cod'
        ? '<h3>Thanh toán khi nhận hàng</h3><p>Bạn thanh toán cho đơn vị giao hàng khi nhận sản phẩm.</p><p class="inline-note">Shop sẽ xác nhận và chuẩn bị đơn hàng trước khi giao.</p>'
        : '<h3>Thanh toán an toàn</h3><p>Thông tin chuyển khoản và mã QR sẽ được cung cấp sau khi đơn hàng được tiếp nhận.</p><p class="inline-note">Đơn hàng chỉ được xác nhận thanh toán sau khi shop kiểm tra giao dịch.</p>';
    });

    document.getElementById('checkoutForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const submit = e.target.querySelector('.checkout-submit');
      if (submit.disabled) return;
      const form = new FormData(e.target);
      const payload = Object.fromEntries(form.entries());
      submit.disabled = true;
      submit.textContent = 'Đang xác nhận...';
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Idempotency-Key': checkoutIdempotencyKey
          },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (!res.ok || !result.ok) {
          const error = new Error(result.message || 'Thanh toán thất bại.');
          error.status = res.status;
          throw error;
        }
        window.location.href = '/don-hang';
      } catch (error) {
        alert(error.message || 'Không thể đặt hàng. Vui lòng thử lại.');
        if (error.status === 409) {
          checkoutIdempotencyKey = crypto.randomUUID
            ? crypto.randomUUID()
            : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        }
        submit.disabled = false;
        submit.textContent = 'Đặt hàng';
      }
    });
  </script>
</body>
</html>
